{
  "plugin_id": "story",
  "tab_id": "storyboard",
  "label": "Story",
  "priority": 200,
  "position": "normal",
  "asset_version": 142,
  "panel_id": "panel-storyboard",
  "api_namespace": "/api/story",
  "storage": "story",
  "enabled": true,
  "system": true,
  "removable": false,
  "description": "Story form — native qnc-app owns UI; playback via broadcast player.",
  "sdk_version": 1,
  "state": {
    "snapshots": [
      {
        "key": "story.state",
        "method": "GET",
        "path": "/api/story/state",
        "query": [
          "project_id"
        ]
      }
    ],
    "invalidates_on": [
      "project:changed"
    ]
  },
  "consumes": {
    "shell_events": [
      "project:changed",
      "keyboard-shortcuts:changed"
    ]
  },
  "backend": {
    "implementation": "rust",
    "host_module": "qnc-host/src/story",
    "store": {
      "scope": "project",
      "persistence": "project_db"
    },
    "actions": [
      {
        "action": "story.part.create",
        "method": "POST",
        "path": "/api/story/part/create",
        "writes": [
          "story.state"
        ]
      },
